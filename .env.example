# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection string — the web app and the indexer share one database
DATABASE_URL=postgres://user:password@localhost:5432/mnstr

# Alchemy MegaETH RPC endpoint — indexer transport for USDm flows, block
# timestamps, chain head, and the realtime WebSocket subscription
ALCHEMY_RPC=https://megaeth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Etherscan v2 API key — used for event backfills (chainid 4326)
ETHERSCAN_KEY=YOUR_ETHERSCAN_KEY

# ── Chain (defaults shown) ────────────────────────────────────────────────
#CHAIN_ID=4326
#RPC_URL=https://mainnet.megaeth.com/rpc
# Separate Alchemy endpoint for heavy backfills (falls back to ALCHEMY_RPC)
#ALCHEMY_RPC_BACKFILL=
# Realtime wss:// endpoint (derived from ALCHEMY_RPC when unset)
#ALCHEMY_WS_URL=
# MnStr public API, used to enrich pulls with card/FMV metadata
#MNSTR_API=https://api.mnstr.xyz

# ── Indexer tuning (defaults shown) ───────────────────────────────────────
#POLL_INTERVAL_MS=300000
#RESTATUS_AGE_HOURS=24
#ENRICH_CONCURRENCY=4
#ENRICH_RPS=8

# ── Telegram alerts (optional — alerting is inert when unset) ─────────────
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# ── Web ───────────────────────────────────────────────────────────────────
# Canonical site origin; non-matching hosts are served with X-Robots-Tag: noindex
#NEXT_PUBLIC_SITE_URL=https://mnstr.watch
# Plausible analytics script src (analytics disabled when unset)
#NEXT_PUBLIC_PLAUSIBLE_SRC=
